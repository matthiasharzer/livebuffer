{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["DOM", "ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"strict": true,
		"target": "ES2023",
		"useDefineForClassFields": false,
		"allowImportingTsExtensions": true
	},
	"include": ["./**/*.ts"]
}
